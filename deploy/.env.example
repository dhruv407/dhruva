# Copy to deploy/.env; keep it outside Git. Use unique values for a real deployment.
RG_DOMAIN=stock-test.example.com
RG_BIND_ADDRESS=127.0.0.1
RG_HTTP_PORT=80
RG_HTTPS_PORT=443
RG_DB_PASSWORD=replace_with_a_unique_url_safe_password
RG_AUTH_USER=rightgold
# Single quotes prevent Compose from interpreting the dollar signs in bcrypt hashes.
RG_AUTH_HASH='replace_with_caddy_bcrypt_hash'
RG_DATA_DIRECTORY=./staging-data
# Optional external AI, entered securely at the deployment host.
# RG_AI_API_KEY=
# RG_AI_MODEL=gpt-4.1-mini
